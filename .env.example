POSTGRES_PASSWORD=replace-with-random-hex-value
FLUXLAKE_API_TOKEN=replace-with-random-hex-value
FLUXLAKE_PUBLIC_DEMO=false
FLUXLAKE_ALLOWED_HOSTS=localhost,127.0.0.1
FLUXLAKE_SOURCE_SYNC=poll

# Optional server-side free-tier Gemini analyst; never expose this key in browser code.
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
